{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokePatchLambdas",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:ap-southeast-5:588589592508:function:serverless-patch-rhel",
        "arn:aws:lambda:ap-southeast-5:588589592508:function:serverless-patch-rhel:*",
        "arn:aws:lambda:ap-southeast-5:588589592508:function:serverless-patch-windows",
        "arn:aws:lambda:ap-southeast-5:588589592508:function:serverless-patch-windows:*",
        "arn:aws:lambda:ap-southeast-5:588589592508:function:serverless-patch-metrics",
        "arn:aws:lambda:ap-southeast-5:588589592508:function:serverless-patch-metrics:*"
      ]
    },
    {
      "Sid": "DiscoverTargets",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "NotifyAdministrator",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-southeast-5:588589592508:serverless-patch-notify"
    }
  ]
}
